# Copy to .env (ignored by git) and adjust. Never commit real secrets.
POSTGRES_DB=aireuskadi
POSTGRES_USER=aireuskadi
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
REDIS_PORT=6379

# Used by the Python code from the host (aireuskadi-db-init, tests); same values as above.
DATABASE_URL=postgresql+psycopg://aireuskadi:change-me@127.0.0.1:5432/aireuskadi

# Only used with the profile `logging`.
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_PORT=3000
