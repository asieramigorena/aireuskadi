# Copy to .env (ignored by git) and adjust. Never commit real secrets.
POSTGRES_DB=aireuskadi
POSTGRES_USER=aireuskadi
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
REDIS_PORT=6379

# Used by the Python code from the host (aireuskadi-db-init, tests); same values as above.
DATABASE_URL=postgresql+psycopg://aireuskadi:change-me@127.0.0.1:5432/aireuskadi

# Read-only role of the services that only read (the emissions API and the air quality API, later
# the gateway). `aireuskadi-db-init` creates it, or updates its password, when both are set.
# Use a password made of letters, digits, "-" and "_" only: it goes inside a URL.
# example: 'openssl rand -base64 24'
POSTGRES_READER_USER=aireuskadi_reader
POSTGRES_READER_PASSWORD=change-me

# The gateway, the only way in for the browser, on this machine.
GATEWAY_PORT=8080

# Grafana, which starts with the rest of the compose.
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_PORT=3000

# Tailscale auth key for the tunnel (`docker compose --profile tunnel up -d tunnel`), made in the
# Tailscale admin console: Settings -> Keys, not reusable, not ephemeral, tag `tag:aireuskadi`,
# 90 days. Only needed the first time: afterwards the identity lives in the `tailscale-state` volume
# and the key can be removed from your .env. Leave it empty here and never commit a real key.
TS_AUTHKEY=
