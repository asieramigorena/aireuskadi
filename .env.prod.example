# For docker-compose.prod.yml, on the VM. Copy it to .env there (it is ignored by git) and set your
# own passwords: they are NOT the ones of the laptop, and they must not be written anywhere else.
# Later they will come from the OCI Vault of Oracle, as the same environment variables.
POSTGRES_DB=aireuskadi
POSTGRES_USER=aireuskadi
# Both passwords go inside a URL (db-init, the scheduler and the services build one with them): use
# letters, digits, "-" and "_" only. A "/", "+", "@" or ":" breaks the URL.
POSTGRES_PASSWORD=
# The read-only role of the services that only read. For example: openssl rand -base64 24 | tr '+/' '-_' | tr -d '='
POSTGRES_READER_USER=aireuskadi_reader
POSTGRES_READER_PASSWORD=

# Where the images are, and which one. :pro is what deploy-pro.yml publishes.
GHCR_OWNER=asieramigorena
IMAGE_TAG=pro

# The folder with the config.json that `docker login ghcr.io` wrote (Watchtower reads the token of
# GHCR from it). It is /root/.docker if the login was done as root; with another user (ubuntu, for
# example) it is that user's ~/.docker. It does not work if config.json has a "credsStore" and no
# "auths" entry: log in with a plain config.
DOCKER_CONFIG_DIR=/root/.docker
